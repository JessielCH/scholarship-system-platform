# Redis Configuration for Upstash
# Set USE_REDIS=true to enable Redis, false or unset to use in-memory repository

# Option 1: Upstash Redis URL (recommended for production)
# REDIS_URL=redis://:password@your-upstash-endpoint.com:port

# Option 2: Manual Redis Configuration
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-password
# REDIS_DB=0

# Server Configuration
PORT=8081

# Feature Flags
USE_REDIS=false
